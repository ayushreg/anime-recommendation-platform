# Kura runs fine with no .env at all. Copy this file to .env only if you need
# to change something, and delete the lines you are not changing.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

# --- ports -------------------------------------------------------------------
# Change these if something else on your machine already uses them.
KURA_WEB_PORT=3000
KURA_API_PORT=8000

# --- secrets -----------------------------------------------------------------
# Only matters if you expose this beyond your own machine.
JWT_SECRET=kura-local-dev-secret
POSTGRES_USER=anime
POSTGRES_PASSWORD=anime
POSTGRES_DB=anime_recs

# --- feature flags -----------------------------------------------------------
# Comma separated overrides, e.g. "social=off,live_data=off".
# Live data (airing schedules, list syncing) is on by default.
KURA_FLAGS=
