{
  "name": "Kura: Local Anime Vault",
  "short_name": "Kura",
  "description": "Local-first anime discovery, tracking, and recommendations that run on your own machine.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#07080f",
  "theme_color": "#ff2d6a",
  "orientation": "any",
  "categories": ["entertainment", "productivity"],
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    { "name": "Continue watching", "url": "/watching" },
    { "name": "For You", "url": "/recommendations" },
    { "name": "Insights", "url": "/insights" }
  ]
}
